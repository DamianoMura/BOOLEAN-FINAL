APP_NAME=JDWDEV.it
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.yourdomain.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Frontend URL (React SPA)
FRONTEND_URL=https://yourdomain.com

# Legacy — kept for backward compat, prefer FRONTEND_URL
GUEST_APP_PORT=

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database — SQLite (demo mode copies base.sqlite per session)
DB_CONNECTION=sqlite

# Sessions stored in files (not DB, since each session has its own DB)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# CORS — comma-separated origins allowed to call the API
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# Sanctum — stateful domains (comma-separated, no protocol)
SANCTUM_STATEFUL_DOMAINS_EXTRA=yourdomain.com,api.yourdomain.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
